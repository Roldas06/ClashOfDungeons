[sub_resource type="GDScript" id="GDScript_edr7y"]
resource_name = "DashCooldown"
script/source = "extends Control

@onready var player : CharacterBody2D = $\"../../Player\"
@onready var label : RichTextLabel = $\"./cooldownLabel\"
@onready var icon : TextureRect = $\"./dashIcon\"

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	icon.scale = Vector2(2.0, 2.0)
	#pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	label.text = \"%.2f\" % player.dash_cooldown
	if player.dash_cooldown == 0.0:
		label.visible = false
		icon.modulate.a = 1.0
	else:
		label.visible = true
		icon.modulate.a = 0.5
"

[sub_resource type="GDScript" id="GDScript_t46w6"]
resource_name = "ProjectileCooldownUI"
script/source = "extends Control

@onready var player : CharacterBody2D = $\"../../Player\"
@onready var label : RichTextLabel = $\"./projectileLabel\"
@onready var icon : TextureRect = $\"./projectileIcon\"


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	label.text = \"%.2f\" % player.projectile_cooldown
	if player.projectile_cooldown == 0.0:
		label.visible = false
		icon.modulate.a = 1.0
	else:
		label.visible = true
		icon.modulate.a = 0.5
"

